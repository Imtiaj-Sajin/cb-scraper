# --- browser profile (large, machine-specific, holds cookies) ---
.browser_profile/

# --- built version folders + PyInstaller scratch (large, regenerated) ---
_v*/
CrunchbaseScraper/
build/
dist/
*.spec

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python

# --- scraper output / exports ---
data/*
!data/.gitkeep
*.csv
*.json
crunchbase*.csv
crunchbase*.json

# --- local dev / test artifacts ---
_test_*
_org_data.json
_test_page.html

# --- editor / OS / tooling ---
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini

# --- logs ---
*.log
